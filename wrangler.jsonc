{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lapor-bencana",
  "main": "src/platform/cloudflare/worker.ts",
  "compatibility_date": "2026-11-15",
  "observability": { "enabled": true },
  "triggers": { "crons": ["*/15 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      // This product's own database, separate from upstream's. Local runs keep it under
      // .wrangler/state; staging gets its own id when the owner creates it.
      "database_name": "lapor-bencana",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      // Report photos, metadata stripped. Local runs keep them under .wrangler/state.
      "bucket_name": "lapor-bencana-photos"
    }
  ],
  "env": {
    // Shared nothing with upstream but the Cloudflare account and the centurisk97.id zone: its own
    // Worker, database, bucket and address. Synthetic data only. KEY_HMAC_SECRET and MODEL_API_KEY are Worker secrets.
    "staging": {
      "name": "lapor-bencana-staging",
      "routes": [{ "pattern": "lapor-bencana.centurisk97.id", "custom_domain": true }],
      "triggers": { "crons": ["*/15 * * * *"] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "lapor-bencana-staging",
          "database_id": "9c7d11d8-e58b-4a53-a17a-0c29e8fa6f59",
          "migrations_dir": "db/migrations"
        }
      ],
      "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "lapor-bencana-photos-staging" }],
      "vars": {
        "APP_ENV": "staging",
        "APP_ORIGIN": "https://lapor-bencana.centurisk97.id",
        "IDENTITY_ADAPTER": "seeded",
        // The key is the Worker secret MODEL_API_KEY, never written in a file.
        "MODEL_MODE": "live",
        "MODEL_BASE_URL": "https://api.anthropic.com",
        "MODEL_NAME": "claude-sonnet-5-5",
        "LOG_LEVEL": "info"
      }
    }
  }
}
