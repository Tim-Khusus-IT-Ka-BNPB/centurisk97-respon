{
  "name": "lapor-bencana",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=26.3.0 <27"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "react-router dev --port 5173 --strictPort",
    "build": "react-router build",
    "preview": "react-router build && wrangler dev --config build/server/wrangler.json --test-scheduled",
    "deploy:staging": "CLOUDFLARE_ENV=staging react-router build && wrangler deploy --config build/server/wrangler.json",
    "typegen": "wrangler types > /dev/null && react-router typegen",
    "test-gateway": "tsx --env-file-if-exists=.env tools/test-gateway/server.ts",
    "model-stub": "tsx --env-file-if-exists=.env tools/model-stub/server.ts",
    "sweep:local": "tsx --env-file-if-exists=.env scripts/sweep-local.ts",
    "reference:import": "tsx --env-file-if-exists=.env tools/reference-import/import.ts",
    "reference:import-file": "tsx --env-file-if-exists=.env tools/reference-import/importFile.ts",
    "push:keys": "tsx tools/push-keys/make.ts",
    "copy:translate": "tsx tools/copy-translate/translate.ts",
    "reference:facilities": "tsx tools/reference-import/buildFacilities.ts",
    "openapi": "vitest run --project server src/api/route.test.ts -t \"OpenAPI document\"",
    "reference:timing": "tsx --env-file-if-exists=.env tools/reference-import/timing.ts",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/db/seed.ts",
    "db:reset": "tsx --env-file-if-exists=.env scripts/db/reset.ts",
    "db:generate": "drizzle-kit generate",
    "db:e2e": "APP_ENV=test DATABASE_URL=${E2E_DATABASE_URL:-postgres://localhost:5432/respon_e2e} sh -c 'pnpm db:reset && pnpm db:seed'",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:mutation": "stryker run",
    "test:e2e": "playwright test",
    "check": "pnpm typegen && tsc -b && biome check . && knip",
    "format": "biome check --write .",
    "scan": "git ls-files -z --cached --others --exclude-standard | xargs -0 secretlint --maskSecrets",
    "bundle:check": "tsx scripts/bundle-check.ts"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@hono/zod-openapi": "1.6.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.20",
    "maplibre-gl": "6.17.0",
    "oauth4webapi": "3.8.9",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.6",
    "supercluster": "9.1.0",
    "tailwind-merge": "3.7.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@cloudflare/vite-plugin": "1.70.1",
    "@playwright/test": "1.64.1",
    "@react-router/dev": "7.18.6",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "4.1.12",
    "drizzle-kit": "0.31.11",
    "jsdom": "31.0.1",
    "knip": "6.48.0",
    "secretlint": "14.1.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "7.3.8",
    "vitest": "4.1.12",
    "wrangler": "4.164.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
