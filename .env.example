# Settings for the server (pnpm dev, pnpm start), the scripts, the model stub and the tests.
# Copy to .env, which git ignores. Every value here is a safe local sample; staging and production
# values are never written in a file.

APP_ENV=local
APP_ORIGIN=http://localhost:5173
PORT=5173

# The local Postgres the dev server, the scripts and the tools use (docs/decisions/0014 in
# centurisk97-platform). Tests copy a template on TEST_DATABASE_URL's server; the browser tests
# use E2E_DATABASE_URL.
DATABASE_URL=postgres://localhost:5432/respon
TEST_DATABASE_URL=postgres://localhost:5432/postgres
E2E_DATABASE_URL=postgres://localhost:5432/respon_e2e

# 32 bytes or more. The seeded keys are made with it, so a new one means seeding again.
KEY_HMAC_SECRET=local-sample-hmac-key-at-least-32-bytes-long

IDENTITY_ADAPTER=seeded
# With IDENTITY_ADAPTER=auth, staff sign in through a local auth (centurisk97-auth) instead:
# AUTH_ISSUER=http://127.0.0.1:3100
# AUTH_CLIENT_ID=respon
# AUTH_CLIENT_SECRET=the respon client secret in auth's CLIENTS, at least 32 bytes

# The public today page at /today: on, or empty to keep it shut.
TODAY_PAGE=on

# off, recorded (the local model stub), or live with your own key. Tests always run without it.
MODEL_MODE=off
MODEL_BASE_URL=http://localhost:8790
MODEL_API_KEY=
MODEL_NAME=recorded

# Local and test only.
CLOCK_FIXED=
FAULT_SEND=
FAULT_PLACE=
ADDRESS_FALLBACK=

# One secret of 32 characters or more per WhatsApp gateway: id=secret id=secret. Empty shuts that door.
# The test gateway's must equal TEST_GATEWAY_SECRET below.
GATEWAY_SECRETS=test-gateway=local-sample-gateway-secret-32-bytes-long

LOG_LEVEL=info

# Warnings to phones (M07): a VAPID pair and a contact the push services accept. All three or none;
# empty keeps warnings shut.
PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=
PUSH_SUBJECT=

# Files: S3 (Garage on the server). Empty on one's own machine: a bucket in memory, gone on restart.
S3_ENDPOINT=
S3_REGION=garage
S3_BUCKET=respon-files
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Model stub.
MODEL_STUB_PORT=8790
MODEL_STUB_DELAY_MS=0
# Optional file the stub appends each call to (hash and masked text). GET /calls returns the same.
MODEL_STUB_LOG=

# The test gateway (pnpm test-gateway), which stands in for WhatsApp on this machine.
TEST_GATEWAY_PORT=8791
# Where the app answers: 5173 for pnpm dev and pnpm start.
TEST_GATEWAY_APP=http://localhost:5173
TEST_GATEWAY_ID=test-gateway
# Must equal its secret in GATEWAY_SECRETS above.
TEST_GATEWAY_SECRET=local-sample-gateway-secret-32-bytes-long
# The number whose "lapor izin 0800..." and "lapor cabut 0800..." change the pilot list.
TEST_GATEWAY_OWNER=080000000000
