# Settings for commands (database tooling, seed, model stub, tests).
# Copy to .env, which git ignores. Secrets go only in .env, never in this file.

APP_ENV=local

# The local Postgres the dev server, the scripts and the tools use (docs/decisions/0014 in
# centurisk97-platform). Tests copy a template on TEST_DATABASE_URL's server; the browser tests
# use E2E_DATABASE_URL.
DATABASE_URL=postgres://localhost:5432/respon
TEST_DATABASE_URL=postgres://localhost:5432/postgres
E2E_DATABASE_URL=postgres://localhost:5432/respon_e2e

# Must equal KEY_HMAC_SECRET in .dev.vars, so seeded keys match what the Worker computes.
KEY_HMAC_SECRET=local-sample-hmac-key-at-least-32-bytes-long

# Model stub.
MODEL_STUB_PORT=8790
MODEL_STUB_DELAY_MS=0
# Optional file the stub appends each call to (hash and masked text). GET /calls returns the same.
MODEL_STUB_LOG=

# The test gateway (pnpm test-gateway), which stands in for WhatsApp on this machine.
TEST_GATEWAY_PORT=8791
# Where the app answers: 5173 for pnpm dev, 8787 for pnpm preview.
TEST_GATEWAY_APP=http://localhost:5173
TEST_GATEWAY_ID=test-gateway
# Must equal its secret in GATEWAY_SECRETS of .dev.vars.
TEST_GATEWAY_SECRET=local-sample-gateway-secret-32-bytes-long
# The number whose "lapor izin 0800..." and "lapor cabut 0800..." change the pilot list.
TEST_GATEWAY_OWNER=080000000000
