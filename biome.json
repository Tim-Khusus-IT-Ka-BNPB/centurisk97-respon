{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!worker-configuration.d.ts", "!**/*.md"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noConsole": "error"
      },
      "style": {
        "noInlineStyles": "error"
      }
    }
  },
  "css": {
    "parser": { "tailwindDirectives": true }
  },
  "overrides": [
    {
      "includes": ["app/**"],
      "plugins": ["./tools/lint/web-storage.grit"],
      "linter": {
        "rules": {
          "a11y": { "noAutofocus": "off" },
          "suspicious": { "noDocumentCookie": "error" }
        }
      }
    },
    {
      "includes": ["scripts/**", "tools/**", "src/platform/log/**"],
      "linter": { "rules": { "suspicious": { "noConsole": "off" } } }
    }
  ]
}
