{
  "extends": "./tsconfig.json",
  "include": [
    "scripts/**/*",
    "tools/**/*",
    "e2e/**/*",
    "db/**/*",
    "src/platform/settings.ts",
    "src/platform/database.ts",
    "src/platform/postgres.ts",
    "src/adapters/s3/store.ts",
    "src/adapters/s3/memoryBucket.ts",
    "src/ports/photoStore.ts",
    "src/platform/keys.ts",
    "src/domain/gateway.ts",
    "src/domain/placeText.ts",
    "src/domain/placeFile.ts",
    "src/domain/shapeFile.ts",
    "src/domain/contacts.ts",
    "src/domain/education.ts",
    "src/domain/responseActions.ts",
    "src/domain/forecast.ts",
    "src/domain/volcano.ts",
    "src/domain/facilities.ts",
    "src/domain/officialEvents.ts",
    "src/platform/webPush.ts",
    "src/copy/translated.ts",
    "src/testing/jpegs.ts",
    "src/domain/modelMessage.ts",
    "vite.config.ts",
    "vite.server.config.ts",
    "vitest.config.ts",
    "vitest.mutation.config.ts",
    "react-router.config.ts",
    "playwright.config.ts"
  ],
  // Scripts that run the whole app are checked with it, in tsconfig.app.json.
  "exclude": ["scripts/sweep-local.ts", "scripts/dev.ts"],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsbuildinfo/node.json",
    "lib": ["ES2024", "DOM"],
    "types": ["node"],
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  }
}
